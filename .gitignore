# ─────────────────────────────────────────────────────────────
#  NUNCA subir nada del juego: ni ISO, ni ELF, ni archivos del disco.
#  Cada uno extrae su propia copia en game/ (ver docs/SETUP.md).
# ─────────────────────────────────────────────────────────────
*.iso
*.bin
*.cue
*.img
*.chd
*.cso
*.mdf
*.nrg
*.zip
*.7z
*.rar
game/*
!game/README.md

# Código C++ generado por el recompilador (derivado del ELF: se regenera en local)
generated/

# Export de Ghidra (rutas locales; se regenera con ghidra-analyze.ps1). Lo que se sube es funcmap.csv
config/gow.toml
config/gow_functions.csv

# Builds y logs
out/
*.log

# Proyectos de Ghidra (contienen el binario del juego)
*.gpr
*.rep/
ghidra/

# Editor / SO
.vs/
.vscode/*
!.vscode/extensions.json
Thumbs.db
desktop.ini

# Archivos que crea el runner al ejecutarse desde la raíz
imgui.ini
ps2_log.txt

# Capturas del runtime (GOW_HOST_SHOT): imágenes del juego, nunca se suben (regla 1)
host_shot.png
# raylib guarda capturas con F12 (screenshotNNN.png) si el runtime se compila sin desactivarlo: también son imágenes del juego
screenshot*.png

build/
artifacts/
dist/
__pycache__/
*.pyc
*.ps2
*.mcd

# Android local SDK, builds, generated game code and signing material
.gradle/
.cxx/
local.properties
*.apk
*.aab
*.jks
*.keystore
android/app/build/
android/app/.cxx/
