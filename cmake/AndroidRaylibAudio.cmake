# Keep the cached upstream checkout intact. raylib 5.5 destroys its audio mutex
# before stopping AAudio's callback, which can still be locking that mutex.
get_target_property(_gow_raylib_source raylib SOURCE_DIR)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_gow_raylib_source}/raudio.c")
file(READ "${_gow_raylib_source}/raudio.c" _gow_audio_source)
set(_gow_old_shutdown "        ma_mutex_uninit(&AUDIO.System.lock);\n        ma_device_uninit(&AUDIO.System.device);\n        ma_context_uninit(&AUDIO.System.context);")
set(_gow_safe_shutdown "        ma_device_uninit(&AUDIO.System.device);\n        ma_context_uninit(&AUDIO.System.context);\n        ma_mutex_uninit(&AUDIO.System.lock);")
string(FIND "${_gow_audio_source}" "${_gow_old_shutdown}" _gow_shutdown_offset)
if(_gow_shutdown_offset EQUAL -1)
    message(FATAL_ERROR "The pinned raylib audio shutdown changed; review the Android callback lifetime fix")
endif()
string(REPLACE "${_gow_old_shutdown}" "${_gow_safe_shutdown}" _gow_audio_source "${_gow_audio_source}")
set(_gow_patched_audio "${CMAKE_CURRENT_BINARY_DIR}/raylib_android_audio.c")
set(_gow_previous_audio "")
if(EXISTS "${_gow_patched_audio}")
    file(READ "${_gow_patched_audio}" _gow_previous_audio)
endif()
if(NOT _gow_previous_audio STREQUAL _gow_audio_source)
    file(WRITE "${_gow_patched_audio}" "${_gow_audio_source}")
endif()
get_target_property(_gow_raylib_sources raylib SOURCES)
set(_gow_fixed_sources "")
foreach(_gow_source IN LISTS _gow_raylib_sources)
    get_filename_component(_gow_source_name "${_gow_source}" NAME)
    if(_gow_source_name STREQUAL "raudio.c")
        list(APPEND _gow_fixed_sources "${_gow_patched_audio}")
    else()
        list(APPEND _gow_fixed_sources "${_gow_source}")
    endif()
endforeach()
set_property(TARGET raylib PROPERTY SOURCES "${_gow_fixed_sources}")
target_include_directories(raylib PRIVATE "${_gow_raylib_source}")
